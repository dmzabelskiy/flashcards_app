DJANGO_DEBUG=false
# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-the-generated-50-character-secret
DJANGO_ALLOWED_HOSTS=flashcards.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://flashcards.example.com
DJANGO_SECURE_HSTS_SECONDS=3600

# Translation providers are tried in order. Russian Wiktionary and MyMemory
# work without keys. DeepL and LibreTranslate are skipped when unconfigured.
VIDEO_STUDY_TRANSLATION_PROVIDERS=wiktionary,deepl,libretranslate,mymemory
VIDEO_STUDY_TRANSLATION_TIMEOUT=8
# VIDEO_STUDY_TRANSLATION_EMAIL=you@example.com
# VIDEO_STUDY_DEEPL_API_KEY=replace-with-a-deepl-api-key
# VIDEO_STUDY_DEEPL_ENDPOINT=https://api-free.deepl.com/v2/translate
# VIDEO_STUDY_LIBRETRANSLATE_ENDPOINT=https://your-instance.example.com
# VIDEO_STUDY_LIBRETRANSLATE_API_KEY=replace-if-required

# PYTHON_BIN=/path/to/python
